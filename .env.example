# Supabase browser Auth variables for the root Next.js / Vercel app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only model credential. Never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional: shared API artifact configuration. Set these to the same Supabase
# project URL and publishable/anon key when running artifacts/api-server.
SUPABASE_URL=
SUPABASE_ANON_KEY=
